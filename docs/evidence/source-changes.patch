+  }
+
+  void drawForeshore(float energy) {
+    stroke(20, 31, 37);
+    strokeWeight(4);
+    line(0, SHORE, 802, SHORE);
+    noStroke();
+    for (int i = 0; i < 35; i++) {
+      float x = i * 22;
+      fill(255, 202, 135, 35 + energy * 128);
+      ellipse(x, SHORE - 1, 2, 2);
